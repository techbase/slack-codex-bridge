{
  "display_information": {
    "name": "Techbase Bridge",
    "description": "Read-only project conversations with a self-hosted Codex runtime",
    "background_color": "#243746"
  },
  "features": {
    "bot_user": { "display_name": "Bridge", "always_online": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "chat:write"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
