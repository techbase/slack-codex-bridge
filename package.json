{
  "name": "@techbase/slack-codex-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted Slack-to-Codex CLI transport with an allowlisted MCP sender",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-timeout=30000 dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "doctor": "node dist/src/main.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/codex": "0.159.3",
    "@slack/bolt": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
